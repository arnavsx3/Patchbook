@inject IJSRuntime JS

<div class="overflow-hidden rounded-xl border border-[#343348] bg-[#252435]">
    <div class="flex items-center justify-between border-b border-[#3c3a50] px-4 py-3">
        <span class="font-mono text-xs text-violet-200">@Language</span>
        <button type="button" @onclick="Copy" class="flex items-center gap-2 rounded-md px-2 py-1 text-xs text-violet-100 hover:bg-white/10" aria-label="Copy code">
            <Icon Name="@(_copied ? "check" : "copy")" Class="size-3.5" /> @(_copied ? "Copied!" : "Copy code")
        </button>
    </div>
    <pre class="overflow-x-auto p-5 font-mono text-sm leading-7 text-[#e1deef]" tabindex="0"><code>@Code</code></pre>
</div>
<p role="status" class="mt-2 text-xs text-muted">@_message</p>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter] public string Language { get; set; } = "text";
    private bool _copied;
    private string _message = "";

    private async Task Copy()
    {
        _copied = await JS.InvokeAsync<bool>("patchbook.copy", Code);
        _message = _copied ? "Code copied to clipboard." : "Clipboard unavailable. Select the code and copy it manually.";
    }
}
